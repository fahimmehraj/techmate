DATABASE_URL=postgres://postgres:postgres@localhost:5432/technyu_coordinator
# `bun dev` derives APP_BASE_URL as https://${NGROK_DOMAIN}.
# Keep APP_BASE_URL=http://localhost:3000 for `bun dev:local`.
APP_BASE_URL=http://localhost:3000
NGROK_DOMAIN=your-reserved-domain.ngrok.app
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY_BASE64=
PORT=3000
ROOM_WORKER_PORT=3001
# Local self-hosted Inngest. These values must match infra/inngest.compose.yml.
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=0123456789abcdef0123456789abcdef
INNGEST_SIGNING_KEY=0123456789abcdef0123456789abcdef
INNGEST_SERVE_HOST=http://host.docker.internal:3000
ROOM_INNGEST_SERVE_HOST=http://host.docker.internal:3001
